# finedisplay.nousworks.co — FineDisplay tanıtım + indirme sayfası (/srv/static/finedisplay).
# Kaynak: apps_ofb/finedisplay/site — deploy: scripts/deploy-site.sh
# DNS A kaydı finedisplay → 78.142.211.44 (2026-08-19 eklendi).

finedisplay.nousworks.co {
	root * /srv/static/finedisplay
	encode gzip

	@tazele path / /index.html /en/ /en/index.html /style.css /dl/SHA256SUMS
	header @tazele Cache-Control "no-cache"
	header /icon.png Cache-Control "public, max-age=86400"
	header /dl/*.zip Cache-Control "public, max-age=3600"
	header /dl/*.zip Content-Disposition "attachment"

	file_server
}
